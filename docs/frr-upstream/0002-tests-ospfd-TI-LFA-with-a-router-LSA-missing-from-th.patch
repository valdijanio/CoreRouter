From c9fe9ca0406d818d505b43a35790585fdec7d9af Mon Sep 17 00:00:00 2001
From: Valdijanio Vieira <48389119+valdijanio@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:57:36 -0300
Subject: [PATCH 2/2] tests: ospfd TI-LFA with a router-LSA missing from the
 LSDB

Add topo6 to test_ospf_spf: the triangle of topo1 plus RT4, which RT3
advertises a point-to-point link to but whose router-LSA is not
injected (the new no_router_lsa flag of a test node). Without the fix,
"test ospf topology topo6 root rt1 ti-lfa" aborts in
get_reverse_distance(); with it, the backup paths are those of topo1.

Signed-off-by: Valdijanio Vieira <48389119+valdijanio@users.noreply.github.com>
---
 tests/ospfd/common.c             |   5 +-
 tests/ospfd/common.h             |   6 ++
 tests/ospfd/test_ospf_spf.in     |   2 +
 tests/ospfd/test_ospf_spf.refout |  26 ++++++
 tests/ospfd/topologies.c         | 132 +++++++++++++++++++++++++++++++
 5 files changed, 170 insertions(+), 1 deletion(-)

diff --git a/tests/ospfd/common.c b/tests/ospfd/common.c
index d56a48fa85..48350f8771 100644
--- a/tests/ospfd/common.c
+++ b/tests/ospfd/common.c
@@ -34,6 +34,8 @@ struct ospf_topology *test_find_topology(const char *name)
 		return &topo4;
 	else if (strmatch(name, "topo5"))
 		return &topo5;
+	else if (strmatch(name, "topo6"))
+		return &topo6;
 
 	return NULL;
 }
@@ -241,7 +243,8 @@ int topology_load(struct vty *vty, struct ospf_topology *topology,
 		tnode = &topology->nodes[i];
 
 		/* Inject a router LSA for each node, used for SPF */
-		inject_router_lsa(vty, ospf, topology, root, tnode);
+		if (!tnode->no_router_lsa)
+			inject_router_lsa(vty, ospf, topology, root, tnode);
 
 		/*
 		 * SR information could also be inected via LSAs, but directly
diff --git a/tests/ospfd/common.h b/tests/ospfd/common.h
index 3a9cf3f5dc..b120e9137b 100644
--- a/tests/ospfd/common.h
+++ b/tests/ospfd/common.h
@@ -17,6 +17,11 @@ struct ospf_test_node {
 	const char *router_id;
 	mpls_label_t label;
 	struct ospf_test_adj adjacencies[MAX_ADJACENCIES + 1];
+	/*
+	 * Don't inject this node's router-LSA: other routers still advertise
+	 * a link to it, as when its LSA has not been received yet.
+	 */
+	bool no_router_lsa;
 };
 
 struct ospf_topology {
@@ -37,6 +42,7 @@ extern struct ospf_topology topo2;
 extern struct ospf_topology topo3;
 extern struct ospf_topology topo4;
 extern struct ospf_topology topo5;
+extern struct ospf_topology topo6;
 extern struct zebra_privs_t ospfd_privs;
 
 /* For stable order in unit tests */
