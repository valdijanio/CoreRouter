+#!/usr/bin/env python
+# SPDX-License-Identifier: ISC
+
+#
+# test_ospf_max_lsa.py
+# Part of NetDEF Topology Tests
+#
+
+"""
+test_ospf_max_lsa.py: the max-lsa limit on the LSAs of other routers.
+
+r2 redistributes 120 static routes into OSPF; r1 has "max-lsa 100
+ignore-time 30 ignore-count 1". r1 goes down (ignore) at the limit,
+comes back after the ignore time, goes down again and stays down
+(isolated) until "clear ip ospf max-lsa". With warning-only it only
+reports the limit, and "no max-lsa" removes it.
+"""
+
+import os
+import sys
+from functools import partial
+import pytest
+
+CWD = os.path.dirname(os.path.realpath(__file__))
+sys.path.append(os.path.join(CWD, "../"))
+
+# pylint: disable=C0413
+from lib import topotest
+from lib.topogen import Topogen, get_topogen
+
+pytestmark = [pytest.mark.ospfd]
+
+
+def setup_module(mod):
+    tgen = Topogen({"s1": ("r1", "r2")}, mod.__name__)
+    tgen.start_topology()
+    for router in tgen.routers().values():
+        router.load_frr_config()
+    tgen.start_router()
+
+
+def teardown_module():
+    get_topogen().stop_topology()
+
+
+def expect_json(router, cmd, expected, count=60):
+    tgen = get_topogen()
+    test_func = partial(topotest.router_json_cmp, tgen.gears[router], cmd, expected)
+    _, result = topotest.run_and_expect(test_func, None, count=count, wait=1)
+    assert result is None, f"{router}: '{cmd}' is not {expected}: {result}"
+
+
+def expect_max_lsa(state, count=60, **more):
+    expected = {"maxLsa": {"limit": 100, "state": state}}
+    expected["maxLsa"].update(more)
+    expect_json("r1", "show ip ospf json", expected, count)
+
+
+def expect_full():
+    get_topogen().gears["r1"].expect_ospfv2_neighbor("10.254.254.2")
+
+
+def redistribute(on):
+    get_topogen().gears["r2"].vtysh_cmd(f"""
+        configure terminal
+        router ospf
+         {"" if on else "no "}redistribute static
+        """)
+
+
+def test_ospf_convergence():
+    tgen = get_topogen()
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+    tgen.gears["r1"].expect_ospfv2_neighbor("10.254.254.2")
+    expect_max_lsa("normal", ignoreEntries=0, threshold=75, warningOnly=False)
+    output = tgen.gears["r1"].vtysh_cmd("show running-config")
+    assert "max-lsa 100 ignore-time 30 ignore-count 1" in output
+
+
+def test_ospf_max_lsa_ignore():
+    tgen = get_topogen()
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    # 120 type-5 LSAs from r2: r1 goes down, its database empties.
+    redistribute(True)
+    expect_max_lsa("ignore", ignoreEntries=1)
+    expect_json(
+        "r1",
+        "show ip ospf neighbor json",
+        {"neighbors": {"10.254.254.2": None}},
+    )
+    expect_json("r1", "show ip ospf json", {"lsaOtherRoutersCounter": 0})
+    # The configuration does not change: no "shutdown".
+    output = tgen.gears["r1"].vtysh_cmd("show running-config")
+    assert "shutdown" not in output
+
+
+def test_ospf_max_lsa_isolated():
+    tgen = get_topogen()
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    # After the 30 s of ignore-time r1 comes back, gets the same LSAs and,
+    # with ignore-count 1, stays down.
+    expect_max_lsa("isolated", count=90, ignoreEntries=1)
+    expect_json(
+        "r1",
+        "show ip ospf neighbor json",
+        {"neighbors": {"10.254.254.2": None}},
+    )
+
+
+def test_ospf_max_lsa_clear():
+    tgen = get_topogen()
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    redistribute(False)
+    tgen.gears["r1"].vtysh_cmd("clear ip ospf max-lsa")
+    expect_max_lsa("normal", ignoreEntries=0)
+    expect_full()
+
+
+def test_ospf_max_lsa_warning_only():
+    tgen = get_topogen()
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    tgen.gears["r1"].vtysh_cmd("""
+        configure terminal
+        router ospf
+         max-lsa 100 warning-only
+        """)
+    redistribute(True)
+    expect_max_lsa("exceeded", warningOnly=True)
+    expect_full()
+
+
+def test_ospf_max_lsa_threshold():
+    tgen = get_topogen()
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    # 120 of 200 is past 50 %.
+    tgen.gears["r1"].vtysh_cmd("""
+        configure terminal
+        router ospf
+         max-lsa 200 threshold 50
+        """)
+    expect_json(
+        "r1",
+        "show ip ospf json",
+        {"maxLsa": {"limit": 200, "threshold": 50, "state": "warning"}},
+    )
+    expect_full()
+
+
+def test_ospf_no_max_lsa():
+    tgen = get_topogen()
+    if tgen.routers_have_failure():
+        pytest.skip(tgen.errors)
+
+    tgen.gears["r1"].vtysh_cmd("""
+        configure terminal
+        router ospf
+         no max-lsa
+        """)
+    expect_json("r1", "show ip ospf json", {"maxLsa": None})
+    output = tgen.gears["r1"].vtysh_cmd("show running-config")
+    assert "max-lsa" not in output
+    expect_full()
+
+
+def test_memory_leak():
+    "Run the memory leak test and report results."
+    tgen = get_topogen()
+    if not tgen.is_memleak_enabled():
+        pytest.skip("Memory leak test/report is disabled")
+    tgen.report_memory_leaks()
+
+
+if __name__ == "__main__":
+    args = ["-s"] + sys.argv[1:]
+    sys.exit(pytest.main(args))
