table inet corerouter
delete table inet corerouter
table inet corerouter {
	set al4_blocked {
		type ipv4_addr
		flags interval, timeout
		auto-merge
		elements = { 203.0.113.0/24, 198.51.100.1-198.51.100.9, 192.0.2.99 timeout 600s }
	}
	set al6_blocked {
		type ipv6_addr
		flags interval, timeout
		auto-merge
		elements = { 2001:db8:bad::/48 }
	}
	set ad4_blocked {
		type ipv4_addr
		size 65536
		flags dynamic, timeout
	}
	set ad6_blocked {
		type ipv6_addr
		size 65536
		flags dynamic, timeout
	}
	set al4_mgmt {
		type ipv4_addr
		flags interval, timeout
		auto-merge
		elements = { 10.0.0.5 }
	}
	set al6_mgmt {
		type ipv6_addr
		flags interval, timeout
		auto-merge
	}
	set il_LAN {
		type ifname
		elements = { "bridge1", "ether2" }
	}
	set il_WAN {
		type ifname
		elements = { "ether1" }
	}
	set ports_22_8291 {
		type inet_service
		flags interval
		elements = { 22, 8291 }
	}
	chain filter_input {
		type filter hook input priority filter; policy accept;
		ct state established,related,untracked counter accept comment "cr:*2"
		ct state invalid counter drop comment "cr:*3"
		meta nfproto ipv4 meta l4proto icmp icmp type 8 icmp code 0 counter accept comment "cr:*4"
		iifname @il_LAN counter accept comment "cr:*5"
		meta nfproto ipv4 ip saddr @al4_blocked counter log prefix "blocked: " comment "cr:*6"
		meta nfproto ipv4 ip saddr @ad4_blocked ip saddr != @al4_blocked counter log prefix "blocked: " comment "cr:*6"
		meta nfproto ipv6 ip6 saddr @al6_blocked counter log prefix "blocked: " comment "cr:*6"
		meta nfproto ipv6 ip6 saddr @ad6_blocked ip6 saddr != @al6_blocked counter log prefix "blocked: " comment "cr:*6"
		meta nfproto ipv4 ip saddr != @al4_mgmt meta l4proto tcp th dport @ports_22_8291 counter jump filter_ssh-guard comment "cr:*7"
		meta nfproto ipv6 ip6 saddr != @al6_mgmt meta l4proto tcp th dport @ports_22_8291 counter jump filter_ssh-guard comment "cr:*7"
		meta nfproto ipv4 meta l4proto tcp th dport 22 ct state new counter add @ad4_blocked { ip saddr timeout 60s } comment "cr:*15"
		meta nfproto ipv6 meta l4proto tcp th dport 22 ct state new counter add @ad6_blocked { ip6 saddr timeout 60s } comment "cr:*15"
		meta nfproto ipv4 meta l4proto icmp icmp type 8 icmp code 0 limit rate 5/second burst 10 packets counter accept comment "cr:*16"
		iifname != @il_LAN counter drop comment "cr:*A"
	}
	chain filter_forward {
		type filter hook forward priority filter; policy accept;
		iifname @il_WAN ct state new ct status & (dnat) == 0 counter reject with icmpx type admin-prohibited comment "cr:*B"
		meta nfproto ipv4 ip saddr != 10.0.0.0/8 ip daddr 192.0.2.0/24 meta l4proto udp th sport 1024-65535 counter comment "cr:*C"
	}
	chain filter_output {
		type filter hook output priority filter; policy accept;
		meta nfproto ipv6 meta l4proto ipv6-icmp counter accept comment "cr:*D"
	}
	chain filter_ssh-guard {
		meta l4proto tcp counter reject with tcp reset comment "cr:*8"
	}
	chain nat_dstnat {
		type nat hook prerouting priority dstnat; policy accept;
		meta nfproto ipv4 iifname "ether1" meta l4proto tcp th dport 8080 counter dnat ip to 10.0.0.20:80 comment "cr:*10"
		meta nfproto ipv6 meta l4proto tcp th dport 443 counter dnat ip6 to [2001:db8::20]:8443 comment "cr:*11"
	}
	chain nat_srcnat {
		type nat hook postrouting priority srcnat; policy accept;
		oifname @il_WAN counter masquerade comment "cr:*E"
		meta nfproto ipv4 oifname "ether1" ip saddr 10.9.0.0/16 meta l4proto udp counter snat ip to 198.51.100.10-198.51.100.12:10000-20000 comment "cr:*F"
	}
	chain mangle_prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname "ether1" ct state new counter ct mark set 0x90a7963e comment "cr:*12"
		ct mark 0x90a7963e counter meta mark set meta mark & 0x0000ffff | 0x57e50000 accept comment "cr:*13"
	}
	chain mangle_forward {
		type filter hook forward priority mangle; policy accept;
		meta mark & 0x0000ffff != 0x00008514 meta mark & 0xffff0000 == 0x57e50000 counter meta mark set meta mark & 0xffff0000 | 0x00008514 comment "cr:*14"
	}
	chain raw_prerouting {
		type filter hook prerouting priority raw; policy accept;
		meta nfproto ipv4 iifname @il_WAN ip saddr @al4_blocked counter drop comment "cr:*16"
		meta nfproto ipv4 iifname @il_WAN ip saddr @ad4_blocked ip saddr != @al4_blocked counter drop comment "cr:*16"
		meta nfproto ipv6 iifname @il_WAN ip6 saddr @al6_blocked counter drop comment "cr:*16"
		meta nfproto ipv6 iifname @il_WAN ip6 saddr @ad6_blocked ip6 saddr != @al6_blocked counter drop comment "cr:*16"
		meta l4proto udp th dport 53 counter notrack accept comment "cr:*17"
	}
	chain raw_output {
		type filter hook output priority raw; policy accept;
		meta l4proto udp th sport 53 counter notrack accept comment "cr:*18"
	}
}
