# The installer's kernel (G1.6c, os/package/corerouter-installer): the
# image's final .config with these on top. The command line has no root=:
# the kernel runs /init from the embedded initramfs (corerouter-init,
# which sees corerouter.mode=live: G1.6y, it moves to the image's root read
# from the medium, or stays on the console installer when it cannot). No
# BTF: nothing here needs eBPF yet (XDP is off in the live image), and
# kbuild then has no pahole step (faster relink, smaller kernel).
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 console=ttyS0,115200 corerouter.mode=live panic=10 quiet"
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# G1.6za: this kernel is another release. A module's vermagic starts with the
# release (kernel/module/version.c), so the modules of the image's kernel,
# built against another .config, cannot load here, nor these in that one; the
# release also names the directory the live image looks in. The ISO carries
# this kernel's own modules in a signed payload (LIVEMODS.IMG).
CONFIG_LOCALVERSION="-live"
# G1.6j, G1.6za: the console installer of the initramfs loads no modules, and
# the live image loads them only when the payload is good: the common cards
# stay built in, so they show a port whatever happens. The E810 runs in Safe
# Mode without its firmware (it asks while probing, before the root is there),
# enough to show the port; it works in full on the installed router. The others
# ask at open, or need nothing. The rest of nics.fragment comes from the payload
# (docs/os-image.md has the table).
CONFIG_ICE=y
CONFIG_BNXT=y
CONFIG_BNX2=y
CONFIG_BNX2X=y
CONFIG_MLX4_EN=y
CONFIG_SFC=y
CONFIG_AQTION=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_SKY2=y
CONFIG_8139TOO=y
# G1.30: no Wi-Fi in the live image, for now: joining a network is a thing of
# the installed router. Without the stack no card driver is built, so the
# payload does not grow by them.
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_RFKILL is not set
