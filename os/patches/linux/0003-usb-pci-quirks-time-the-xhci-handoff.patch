From: CoreRouter <noreply@corerouter>
Subject: [PATCH] usb: pci-quirks: say where a slow xHCI handoff spends its time

On a Lenovo 83EU (Alder Lake-H, BIOS LZCN41WW) booted from a USB
stick, quirk_usb_early_handoff() took 20.47 s on the xHCI at 00:14.0
and printed nothing but pci_do_fixups()'s "took 19992855 usecs" (that
number is ns >> 10). None of the handoff timeouts fired, and since
commit 7349a69cf312 ("iopoll: Do not use timekeeping in
read_poll_timeout_atomic()") handshake() counts poll iterations, not
time, so a step can run far past its nominal timeout in silence; time
spent in SMM is invisible to it.

Time every step of the handoff with ktime_get() and, on Intel, count
the SMIs taken in each one (MSR_SMI_COUNT, 0x34), so that one long SMI
on the OS-owned write, an SMI storm while polling, ACPI _PS0 in
pci_enable_device() and a slow Controller Not Ready can be told apart.
Print the breakdown with the same 10 ms threshold as pci_do_fixups()
(or always with initcall_debug), with USBLEGSUP and USBLEGCTLSTS as the
firmware left them. Two read-backs flush the posted writes so their
cost lands in the right step; nothing else changes.

CoreRouter gap G1.6zq.

---
--- a/drivers/usb/host/pci-quirks.c
+++ b/drivers/usb/host/pci-quirks.c
@@ -18,6 +18,12 @@
 #include <linux/dmi.h>
 #include <linux/of.h>
 #include <linux/iopoll.h>
+#include <linux/init.h>
+#include <linux/ktime.h>
+#ifdef CONFIG_X86
+#include <asm/msr.h>
+#include <asm/processor.h>
+#endif
 
 #include "pci-quirks.h"
 #include "xhci-ext-caps.h"
@@ -1148,6 +1154,91 @@
 EXPORT_SYMBOL_GPL(usb_disable_xhci_ports);
 
 /*
+ * Where a slow xHCI handoff spends its time.
+ *
+ * pci_do_fixups() only says that the whole quirk took long. The firmware
+ * releases the controller in SMM, where the kernel cannot see it, and
+ * handshake() counts poll iterations, not time, so a step can run far past
+ * its nominal timeout without printing anything. Time every step and, on
+ * Intel, count the SMIs taken in it (MSR_SMI_COUNT): one long SMI and an SMI
+ * storm look the same from the outside and need different fixes.
+ */
+enum xhci_handoff_step {
+	XHCI_STEP_ENABLE,	/* pci_enable_device(): ACPI _PS0, IRQ routing */
+	XHCI_STEP_MAP,		/* ioremap() and the extended capability walk */
+	XHCI_STEP_OWN_WRITE,	/* the write of HC OS Owned */
+	XHCI_STEP_OWN_WAIT,	/* waiting for HC BIOS Owned to clear */
+	XHCI_STEP_SMI_OFF,	/* disabling the legacy SMIs */
+	XHCI_STEP_PORTS,	/* usb_enable_intel_xhci_ports() */
+	XHCI_STEP_CNR,		/* waiting for Controller Not Ready to clear */
+	XHCI_STEP_HALT,		/* stop the controller and wait for HCHalted */
+	XHCI_STEP_DISABLE,	/* pci_disable_device() */
+	XHCI_STEPS
+};
+
+static const char * const xhci_handoff_step_name[XHCI_STEPS] = {
+	"enable", "map", "OS-owned write", "BIOS release", "SMI off",
+	"Intel ports", "CNR", "halt", "disable",
+};
+
+struct xhci_handoff_trace {
+	ktime_t start, mark;
+	u64 smi_start, smi_mark;
+	s64 us[XHCI_STEPS];
+	u64 smis[XHCI_STEPS];
+	u32 legsup, legctl;	/* as the firmware left them */
+};
+
+static u64 xhci_handoff_smi_count(void)
+{
+#ifdef CONFIG_X86
+	u64 count;
+
+	if (boot_cpu_data.x86_vendor == X86_VENDOR_INTEL &&
+	    !rdmsrq_safe(MSR_SMI_COUNT, &count))
+		return count;
+#endif
+	return 0;
+}
+
+static void xhci_handoff_trace_start(struct xhci_handoff_trace *tr)
+{
+	memset(tr, 0, sizeof(*tr));
+	tr->start = tr->mark = ktime_get();
+	tr->smi_start = tr->smi_mark = xhci_handoff_smi_count();
+}
+
+static void xhci_handoff_mark(struct xhci_handoff_trace *tr,
+			      enum xhci_handoff_step step)
+{
+	ktime_t now = ktime_get();
+	u64 smi = xhci_handoff_smi_count();
+
+	tr->us[step] += ktime_us_delta(now, tr->mark);
+	tr->smis[step] += smi - tr->smi_mark;
+	tr->mark = now;
+	tr->smi_mark = smi;
+}
+
+/* Same threshold as the "took ... usecs" line of pci_do_fixups(). */
+static void xhci_handoff_report(struct pci_dev *pdev,
+				struct xhci_handoff_trace *tr)
+{
+	s64 total = ktime_us_delta(tr->mark, tr->start);
+	int i;
+
+	if (!initcall_debug && total < 10 * USEC_PER_MSEC)
+		return;
+	pci_info(pdev, "xHCI handoff: %lld us, %llu SMIs; USBLEGSUP %08x USBLEGCTLSTS %08x\n",
+		 total, tr->smi_mark - tr->smi_start, tr->legsup, tr->legctl);
+	for (i = 0; i < XHCI_STEPS; i++)
+		if (tr->us[i] >= 1000 || tr->smis[i])
+			pci_info(pdev, "xHCI handoff:   %s: %lld us, %llu SMIs\n",
+				 xhci_handoff_step_name[i], tr->us[i],
+				 tr->smis[i]);
+}
+
+/*
  * PCI Quirks for xHCI.
  *
  * Takes care of the handoff between the Pre-OS (i.e. BIOS) and the OS.
@@ -1155,7 +1246,8 @@
  * and then waits 1 second for the BIOS to hand over control.
  * If we timeout, assume the BIOS is broken and take control anyway.
  */
-static void quirk_usb_handoff_xhci(struct pci_dev *pdev)
+static void quirk_usb_handoff_xhci(struct pci_dev *pdev,
+				   struct xhci_handoff_trace *tr)
 {
 	void __iomem *base;
 	int ext_cap_offset;
@@ -1186,6 +1278,9 @@
 		goto iounmap;
 	}
 	val = readl(base + ext_cap_offset);
+	tr->legsup = val;
+	tr->legctl = readl(base + ext_cap_offset + XHCI_LEGACY_CONTROL_OFFSET);
+	xhci_handoff_mark(tr, XHCI_STEP_MAP);
 
 	/* Auto handoff never worked for these devices. Force it and continue */
 	if ((pdev->vendor == PCI_VENDOR_ID_TI && pdev->device == 0x8241) ||
@@ -1198,10 +1293,14 @@
 	/* If the BIOS owns the HC, signal that the OS wants it, and wait */
 	if (val & XHCI_HC_BIOS_OWNED) {
 		writel(val | XHCI_HC_OS_OWNED, base + ext_cap_offset);
+		/* the read flushes the posted write */
+		readl(base + ext_cap_offset);
+		xhci_handoff_mark(tr, XHCI_STEP_OWN_WRITE);
 
 		/* Wait for 1 second with 10 microsecond polling interval */
 		timeout = handshake(base + ext_cap_offset, XHCI_HC_BIOS_OWNED,
 				0, 1000000, 10);
+		xhci_handoff_mark(tr, XHCI_STEP_OWN_WAIT);
 
 		/* Assume a buggy BIOS and take HC ownership anyway */
 		if (timeout) {
@@ -1219,10 +1318,14 @@
 	val |= XHCI_LEGACY_SMI_EVENTS;
 	/* Disable any BIOS SMIs and clear all SMI events*/
 	writel(val, base + ext_cap_offset + XHCI_LEGACY_CONTROL_OFFSET);
+	readl(base + ext_cap_offset + XHCI_LEGACY_CONTROL_OFFSET);
+	xhci_handoff_mark(tr, XHCI_STEP_SMI_OFF);
 
 hc_init:
+	xhci_handoff_mark(tr, XHCI_STEP_MAP);
 	if (pdev->vendor == PCI_VENDOR_ID_INTEL)
 		usb_enable_intel_xhci_ports(pdev);
+	xhci_handoff_mark(tr, XHCI_STEP_PORTS);
 
 	op_reg_base = base + XHCI_HC_LENGTH(readl(base));
 
@@ -1238,6 +1341,7 @@
 			 "xHCI HW not ready after 5 sec (HC bug?) status = 0x%x\n",
 			 val);
 	}
+	xhci_handoff_mark(tr, XHCI_STEP_CNR);
 
 	/* Send the halt and disable interrupts command */
 	val = readl(op_reg_base + XHCI_CMD_OFFSET);
@@ -1253,6 +1357,7 @@
 			 "xHCI HW did not halt within %d usec status = 0x%x\n",
 			 XHCI_MAX_HALT_USEC, val);
 	}
+	xhci_handoff_mark(tr, XHCI_STEP_HALT);
 
 iounmap:
 	iounmap(base);
@@ -1260,6 +1365,7 @@
 
 static void quirk_usb_early_handoff(struct pci_dev *pdev)
 {
+	struct xhci_handoff_trace tr;
 	struct device_node *parent;
 	bool is_rpi;
 
@@ -1287,11 +1393,13 @@
 			pdev->class != PCI_CLASS_SERIAL_USB_XHCI)
 		return;
 
+	xhci_handoff_trace_start(&tr);
 	if (pci_enable_device(pdev) < 0) {
 		dev_warn(&pdev->dev,
 			 "Can't enable PCI device, BIOS handoff failed.\n");
 		return;
 	}
+	xhci_handoff_mark(&tr, XHCI_STEP_ENABLE);
 	if (pdev->class == PCI_CLASS_SERIAL_USB_UHCI)
 		quirk_usb_handoff_uhci(pdev);
 	else if (pdev->class == PCI_CLASS_SERIAL_USB_OHCI)
@@ -1299,8 +1407,13 @@
 	else if (pdev->class == PCI_CLASS_SERIAL_USB_EHCI)
 		quirk_usb_disable_ehci(pdev);
 	else if (pdev->class == PCI_CLASS_SERIAL_USB_XHCI)
-		quirk_usb_handoff_xhci(pdev);
+		quirk_usb_handoff_xhci(pdev, &tr);
+	xhci_handoff_mark(&tr, XHCI_STEP_MAP);
 	pci_disable_device(pdev);
+	if (pdev->class == PCI_CLASS_SERIAL_USB_XHCI) {
+		xhci_handoff_mark(&tr, XHCI_STEP_DISABLE);
+		xhci_handoff_report(pdev, &tr);
+	}
 }
 DECLARE_PCI_FIXUP_CLASS_FINAL(PCI_ANY_ID, PCI_ANY_ID,
 			PCI_CLASS_SERIAL_USB, 8, quirk_usb_early_handoff);
