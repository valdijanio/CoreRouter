+	struct ospf *ospf = NULL;
+	struct vrf *vrf = NULL;
+
+	if (instance != 0 && instance != ospf_instance)
+		return CMD_NOT_MY_INSTANCE;
+
+	if (vrf_name) {
+		vrf = vrf_lookup_by_name(vrf_name);
+		if (!vrf) {
+			vty_out(vty, "%% VRF %s not found\n", vrf_name);
+			return CMD_WARNING;
+		}
+	}
+
+	for (ALL_LIST_ELEMENTS_RO(om->ospf, node, ospf)) {
+		if (vrf && ospf->vrf_id != vrf->vrf_id)
+			continue;
+		ospf_max_lsa_clear(ospf);
+	}
+
+	return CMD_SUCCESS;
+}
