+static void config_write_max_lsa(struct vty *vty, struct ospf *ospf)
+{
+	struct ospf_max_lsa *m = &ospf->max_lsa;
+
+	if (!m->limit)
+		return;
+	vty_out(vty, " max-lsa %u", m->limit);
+	if (m->threshold != OSPF_MAX_LSA_THRESHOLD_DEFAULT)
+		vty_out(vty, " threshold %u", m->threshold);
+	if (m->warning_only)
+		vty_out(vty, " warning-only");
+	if (m->ignore_time != OSPF_MAX_LSA_IGNORE_TIME_DEFAULT)
+		vty_out(vty, " ignore-time %u", m->ignore_time);
+	if (m->ignore_count != OSPF_MAX_LSA_IGNORE_COUNT_DEFAULT)
+		vty_out(vty, " ignore-count %u", m->ignore_count);
+	if (m->reset_time != OSPF_MAX_LSA_RESET_TIME_DEFAULT)
+		vty_out(vty, " reset-time %u", m->reset_time);
+	vty_out(vty, "\n");
+}
