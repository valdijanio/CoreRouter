@@ -135,6 +135,45 @@ enum {
 	OSPF_SHUTDOWN = (1 << 6),
 };
 
+/*
+ * max-lsa: a limit on the LSAs of other routers in the link-state
+ * database, so that a wrong redistribution elsewhere in the domain cannot
+ * run this router out of memory. Above the limit the instance goes down
+ * for ignore-time (all adjacencies and the learned LSAs go: the databases
+ * of the area stay consistent, as nothing routes through this router),
+ * then comes back; after ignore-count such periods it stays down until
+ * "clear ip ospf max-lsa".
+ */
+enum ospf_max_lsa_state {
+	OSPF_MAX_LSA_NORMAL = 0,
+	OSPF_MAX_LSA_IGNORE,
+	OSPF_MAX_LSA_ISOLATED,
+};
+
+#define OSPF_MAX_LSA_THRESHOLD_DEFAULT	  75
+#define OSPF_MAX_LSA_IGNORE_TIME_DEFAULT  300
+#define OSPF_MAX_LSA_IGNORE_COUNT_DEFAULT 5
+#define OSPF_MAX_LSA_RESET_TIME_DEFAULT	  600
+
+struct ospf_max_lsa {
+	/* Configuration; limit 0 = no limit. */
+	uint32_t limit;
+	uint8_t threshold; /* percent of the limit that logs a warning */
+	bool warning_only;
+	uint32_t ignore_time;  /* seconds */
+	uint32_t ignore_count; /* ignore periods before isolated */
+	uint32_t reset_time;   /* seconds up that reset the ignore periods */
+
+	/* State. */
+	enum ospf_max_lsa_state state;
+	uint32_t ignore_entries;
+	bool warned;   /* above the threshold, logged once */
+	bool exceeded; /* above the limit with warning-only, logged once */
+	struct event *t_check;
+	struct event *t_ignore;
+	struct event *t_reset;
+};
+
