+	zlog_notice("OSPF[%s]: max-lsa: ignore state over, interfaces come up again (%u of %u ignore periods)",
+		    ospf_get_name(ospf), m->ignore_entries, m->ignore_count);
+	event_add_timer(master, ospf_max_lsa_reset_timer, ospf, m->reset_time,
+			&m->t_reset);
+	if (!ospf_is_down(ospf))
+		ospf_instance_up(ospf);
+}
+
+static void ospf_max_lsa_ignore(struct ospf *ospf, unsigned long count)
+{
+	struct ospf_max_lsa *m = &ospf->max_lsa;
+
+	event_cancel(&m->t_reset);
+	if (m->ignore_entries >= m->ignore_count) {
+		m->state = OSPF_MAX_LSA_ISOLATED;
+		zlog_warn("OSPF[%s]: max-lsa: %lu LSAs of other routers, above the limit of %u: down after %u ignore periods, until \"clear ip ospf max-lsa\"",
+			  ospf_get_name(ospf), count, m->limit,
+			  m->ignore_count);
 	} else {
-		UNSET_FLAG(ospf->config, OSPF_SHUTDOWN);
+		m->ignore_entries++;
+		m->state = OSPF_MAX_LSA_IGNORE;
+		event_add_timer(master, ospf_max_lsa_ignore_end, ospf,
+				m->ignore_time, &m->t_ignore);
+		zlog_warn("OSPF[%s]: max-lsa: %lu LSAs of other routers, above the limit of %u: down for %u s (ignore period %u of %u)",
+			  ospf_get_name(ospf), count, m->limit, m->ignore_time,
+			  m->ignore_entries, m->ignore_count);
+	}
+	ospf_instance_down(ospf);
+}
+
+/* The LSAs of other routers in all the databases of the instance:
+ * O(areas), run at most once per event loop pass. */
+unsigned long ospf_max_lsa_count(struct ospf *ospf)
+{
+	struct ospf_area *area;
+	struct listnode *node;
+	unsigned long total, self = 0, count;
+	int type;
+
+	total = ospf_lsdb_count_all(ospf->lsdb);
+	for (type = OSPF_MIN_LSA; type < OSPF_MAX_LSA; type++)
+		self += ospf_lsdb_count_self(ospf->lsdb, type);
+	for (ALL_LIST_ELEMENTS_RO(ospf->areas, node, area)) {
+		total += ospf_lsdb_count_all(area->lsdb);
+		for (type = OSPF_MIN_LSA; type < OSPF_MAX_LSA; type++)
+			self += ospf_lsdb_count_self(area->lsdb, type);
+	}
+	count = total > self ? total - self : 0;
+	return count;
+}
+
+static void ospf_max_lsa_check(struct event *t)
+{
+	struct ospf *ospf = EVENT_ARG(t);
+	struct ospf_max_lsa *m = &ospf->max_lsa;
+	unsigned long count, warn;
+
+	if (!m->limit || ospf_is_down(ospf))
+		return;
+
+	count = ospf_max_lsa_count(ospf);
+	if (count > m->limit) {
+		if (!m->warning_only) {
+			ospf_max_lsa_ignore(ospf, count);
+			return;
+		}
+		if (!m->exceeded)
+			zlog_warn("OSPF[%s]: max-lsa: %lu LSAs of other routers, above the limit of %u (warning-only)",
+				  ospf_get_name(ospf), count, m->limit);
+		m->exceeded = true;
+		return;
+	}
+	m->exceeded = false;
+
+	warn = (unsigned long)m->limit * m->threshold / 100;
+	if (count >= warn) {
+		if (!m->warned)
+			zlog_warn("OSPF[%s]: max-lsa: %lu LSAs of other routers, %u%% of the limit of %u reached",
+				  ospf_get_name(ospf), count, m->threshold,
+				  m->limit);
+		m->warned = true;
+	} else
+		m->warned = false;
+}
+
+/* Called for each LSA of another router added to a database: one check
+ * after the packet that brought it (the event runs once per pass). */
+void ospf_max_lsa_check_schedule(struct ospf *ospf)
+{
+	if (ospf->max_lsa.limit)
+		event_add_event(master, ospf_max_lsa_check, ospf, 0,
+				&ospf->max_lsa.t_check);
+}
+
+/* Leave the ignore or isolated state now and forget the ignore periods. */
+void ospf_max_lsa_clear(struct ospf *ospf)
+{
+	struct ospf_max_lsa *m = &ospf->max_lsa;
+	bool was_down = ospf_is_down(ospf);
+
+	event_cancel(&m->t_ignore);
+	event_cancel(&m->t_reset);
+	m->ignore_entries = 0;
+	m->warned = false;
+	m->exceeded = false;
+	m->state = OSPF_MAX_LSA_NORMAL;
+	if (was_down && !ospf_is_down(ospf)) {
+		zlog_notice("OSPF[%s]: max-lsa: cleared, interfaces come up again",
+			    ospf_get_name(ospf));
+		ospf_instance_up(ospf);
+	}
+	ospf_max_lsa_check_schedule(ospf);
+}
+
+void ospf_max_lsa_set(struct ospf *ospf, uint32_t limit, uint8_t threshold,
+		      bool warning_only, uint32_t ignore_time,
+		      uint32_t ignore_count, uint32_t reset_time)
+{
+	struct ospf_max_lsa *m = &ospf->max_lsa;
 
-		/* Spin up all interfaces */
-		for (ALL_LIST_ELEMENTS_RO(ospf->oiflist, node, oi))
-			ospf_if_up(oi);
+	m->limit = limit;
+	m->threshold = threshold;
+	m->warning_only = warning_only;
+	m->ignore_time = ignore_time;
+	m->ignore_count = ignore_count;
+	m->reset_time = reset_time;
 
-		ospf_asbr_reoriginate(ospf);
+	/* No limit, or only warnings: nothing holds the instance down. */
+	if (!limit || warning_only) {
+		if (m->state != OSPF_MAX_LSA_NORMAL || m->ignore_entries)
+			ospf_max_lsa_clear(ospf);
+		if (!limit)
+			event_cancel(&m->t_check);
 	}
+	m->warned = false;
+	m->exceeded = false;
+	ospf_max_lsa_check_schedule(ospf);
+}
+
+const char *ospf_max_lsa_state_str(struct ospf *ospf, unsigned long count)
+{
+	struct ospf_max_lsa *m = &ospf->max_lsa;
+
+	if (m->state == OSPF_MAX_LSA_ISOLATED)
+		return "isolated";
+	if (m->state == OSPF_MAX_LSA_IGNORE)
+		return "ignore";
+	if (!m->limit)
+		return "off";
+	if (count > m->limit)
+		return "exceeded";
+	if (count >= (unsigned long)m->limit * m->threshold / 100)
+		return "warning";
+	return "normal";
 }
